{
  "name": "youtube-hdr-cleaner",
  "version": "1.1.0",
  "private": true,
  "license": "MIT",
  "author": "Rajot Das",
  "description": "YouTube HDR Cleaner: Chrome extension that fixes too-bright YouTube HDR videos by blocking HDR10, Dolby Vision and HLG streams or dimming them to SDR brightness",
  "repository": "github:iRajatDas/youtube-hdr-cleaner",
  "scripts": {
    "dev": "node scripts/build.js --watch",
    "dev:firefox": "node scripts/build.js --watch --target=firefox",
    "build": "node scripts/build.js --prod",
    "build:dev": "node scripts/build.js",
    "build:firefox": "node scripts/build.js --target=firefox",
    "package": "npm run build && node scripts/package.js",
    "lint:firefox": "web-ext lint --source-dir dist-firefox",
    "icons": "sh scripts/generate-icons.sh",
    "clean": "rm -rf dist dist-firefox *.zip"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "web-ext": "^10.8.0"
  }
}
