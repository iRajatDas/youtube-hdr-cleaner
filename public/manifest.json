{
  "manifest_version": 3,
  "name": "YouTube HDR Cleaner – Fix Too-Bright HDR Videos",
  "short_name": "HDR Cleaner",
  "version": "1.3.0",
  "description": "Stop YouTube HDR videos from being too bright. Blocks HDR10, Dolby Vision and HLG streams or dims them to normal SDR levels.",
  "homepage_url": "https://github.com/iRajatDas/youtube-hdr-cleaner",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "*://www.youtube.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.youtube.com/*"
      ],
      "js": [
        "page.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "*://www.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    },
    "default_title": "YouTube HDR Cleaner"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
